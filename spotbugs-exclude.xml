<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 
        Suppress internal representation exposure (EI_EXPOSE_REP and EI_EXPOSE_REP2).
        These are frequent in DTOs and Entities and are often considered noise 
        when the objects are primarily data carriers.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
</FindBugsFilter>
