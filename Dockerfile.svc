# apps/backend/Dockerfile.svc — Generic Dockerfile for all svc-* modules
# Usage (docker-compose):
#   build:
#     context: ../backend
#     dockerfile: Dockerfile.svc
#     args:
#       SVC_NAME: svc-banking

ARG SVC_NAME=svc-banking

# ── Stage 1: Build ──
FROM maven:3.9-eclipse-temurin-25 AS builder
ARG SVC_NAME
WORKDIR /build

# Copy parent POM and all module POMs for reactor resolution
COPY pom.xml .
COPY aurix-shared/pom.xml aurix-shared/
COPY aurix-shared/src aurix-shared/src

# Copy all svc-* and gateway pom.xml so parent's <modules> resolve
COPY svc-ai/pom.xml svc-ai/
COPY svc-banking/pom.xml svc-banking/
COPY svc-cambio/pom.xml svc-cambio/
COPY svc-cards/pom.xml svc-cards/
COPY svc-compliance/pom.xml svc-compliance/
COPY svc-contracts/pom.xml svc-contracts/
COPY svc-credit/pom.xml svc-credit/
COPY svc-customer/pom.xml svc-customer/
COPY svc-finance-mgmt/pom.xml svc-finance-mgmt/
COPY svc-fraud/pom.xml svc-fraud/
COPY svc-intelligence/pom.xml svc-intelligence/
COPY svc-payments/pom.xml svc-payments/
COPY svc-platform/pom.xml svc-platform/
COPY svc-products/pom.xml svc-products/
COPY aurix-gateway/pom.xml aurix-gateway/

# Cache dependencies for the target module only
RUN mvn dependency:go-offline -pl ${SVC_NAME} -am -q -B

# Copy target service source and build
COPY ${SVC_NAME}/src ${SVC_NAME}/src
RUN mvn package -pl ${SVC_NAME} -am -DskipTests -q -B

# ── Stage 2: Runtime ──
FROM eclipse-temurin:25-jre-jammy
ARG SVC_NAME
ARG PORT=8080
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN groupadd -r aurix && useradd -r -g aurix aurix
USER aurix
COPY --from=builder /build/${SVC_NAME}/target/*.jar app.jar
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom"
EXPOSE ${PORT}
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
